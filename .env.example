# DJ Pro configuration. Copy to .env and edit. Every value has a default except DJ_PASSWORD,
# which you really should set before anyone else joins.

# HTTP port the server listens on.
PORT=8080

# Password for the single DJ seat. POST it to /api/admin/login (or send an `auth` frame on the
# websocket) to take the decks. If unset the server logs a loud warning and falls back to
# "letmein" - fine for a laptop, not for the internet.
DJ_PASSWORD=change-me

# HMAC key for the httpOnly `dj_session` cookie. If unset a random one is generated at boot,
# which means DJ sessions are invalidated on every restart. Set it to keep them:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: YouTube Data API v3 key. Without it /api/search returns 501 and the DJ pastes URLs
# instead (/api/resolve needs no key). https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Where the queue/title snapshot (room.json) is written.
DATA_DIR=./data
